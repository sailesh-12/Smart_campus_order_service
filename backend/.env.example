# Copy to backend/.env for local runs against hosted services. Never commit .env.
# Neon Postgres: pooled JDBC URL, e.g. jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Upstash Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true
# CloudAMQP RabbitMQ: amqps://<user>:<password>@<host>/<vhost>
spring.rabbitmq.addresses=
# Optional overrides (defaults are dev-only values)
JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=
